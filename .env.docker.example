# ─────────────────────────────────────────────────────────────────────────────
# Mẫu cho .env.docker (stack production: docker-compose.yml ở thư mục gốc).
#   cp .env.docker.example .env.docker   # rồi điền giá trị thật; .env.docker bị .gitignore, KHÔNG commit
#   docker compose --env-file .env.docker up -d --build
#
# File này CHỈ chứa placeholder. Chạy compose luôn kèm `--env-file .env.docker` để các biến ${...} trong
# docker-compose.yml (mật khẩu Mongo/Redis/MinIO, CLOUDFLARE_TUNNEL_TOKEN) đọc từ đúng file này; đồng
# thời backend nạp cùng file qua env_file. Chi tiết: docs/01_Infrastructure/06_Production_Deploy.md
#
# Quy tắc giá trị: không bọc nháy, không có khoảng trắng hay ký tự $ # ` \. Riêng MONGO_ROOT_PASSWORD và
# REDIS_PASSWORD phải an toàn cho URL (backend ghép vào mongodb:// và redis://): dùng hex, không dùng base64
# (có + / =). Sinh mật khẩu mạnh:   openssl rand -hex 24
#   (không có openssl:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))")
# ─────────────────────────────────────────────────────────────────────────────

# ════════════ BIẾN MỚI (bổ sung cho Mongo replica set + Redis + MinIO) ════════════
# Tất cả đều BẮT BUỘC trừ khi ghi "tùy chọn". Thiếu là `docker compose` báo lỗi ngay.

# ── MongoDB (replica set rs0 + xác thực) ─────────────────────────────────────
# Tài khoản root, tạo tự động khi volume mongo_data RỖNG. Volume cũ đã có dữ liệu: xem tài liệu mục 5.
MONGO_ROOT_USERNAME=<ten-user-root-vd-remroot>
MONGO_ROOT_PASSWORD=<openssl rand -hex 24>
# Nội dung keyFile của replica set (cùng chuỗi trên mọi node; mất/đổi khóa thì phải dừng cả cụm để đổi).
# Chuỗi base64/hex 6-1024 ký tự, 1 dòng:   openssl rand -hex 64
MONGO_KEYFILE=<openssl rand -hex 64>

# ── Redis (BullMQ, idempotency) ──────────────────────────────────────────────
REDIS_PASSWORD=<openssl rand -hex 24>

# ── MinIO / S3 ───────────────────────────────────────────────────────────────
# Vừa là root user/password của MinIO, vừa là access key của backend (cùng giá trị, không thể lệch).
# Tối thiểu: user >= 3 ký tự, password >= 8 ký tự. KHÔNG dùng minioadmin.
S3_ACCESS_KEY_ID=<ten-user-minio-vd-remstorage>
S3_SECRET_ACCESS_KEY=<openssl rand -hex 24>
# Tùy chọn: pin image MinIO theo digest cho production (mặc định cgr.dev/chainguard/minio:latest).
# MINIO_IMAGE=cgr.dev/chainguard/minio@sha256:<digest>
# Tùy chọn: đổi tên bucket (mặc định bên dưới; đổi thì minio-init và backend tự khớp nhau).
# S3_BUCKET_ATTACHMENTS=crm-attachments
# S3_BUCKET_EXPORTS=crm-exports

# ── Backend: URL công khai để TRÌNH DUYỆT tải ảnh/export (signed URL) ───────
# Hostname riêng qua Cloudflare Tunnel -> http://minio:9000 (dashboard Cloudflare). Dùng https, không dấu "/" cuối.
# Để trống = backend ký bằng http://minio:9000 (trình duyệt KHÔNG truy cập được): chỉ chấp nhận khi chưa bật ảnh/export.
S3_PUBLIC_ENDPOINT=https://<hostname-file-cong-khai>
# Tùy chọn: hạn signed URL (giây), mặc định 900 = 15 phút.
# S3_SIGNED_URL_TTL_SECONDS=900
# Tùy chọn: tiền tố key Redis (mặc định rem:).
# REDIS_KEY_PREFIX=rem:

# ── Module CRM (chưa bật: mặc định tắt) ─────────────────────────────────────
# Cờ dùng CHUNG cho backend (FEATURE_CRM_*) và bản build frontend (VITE_*): compose tự chuyển, hai phía không lệch.
# KHÔNG đặt FEATURE_CRM_ENABLED / FEATURE_CRM_ATTACHMENTS ở file này (compose ghi đè). Đổi cờ thì phải
# BUILD LẠI frontend (cờ Vite nhúng lúc build): docker compose --env-file .env.docker up -d --build
# Thứ tự bật: sinh + SAO LƯU khóa PII, điền CRM_PII_ENCRYPTION_KEY, rồi mới đặt CRM_ENABLED=true.
CRM_ENABLED=false   # chỉ ghi đúng true/false chữ thường (frontend không nhận 1/yes/on, backend thì có => lệch)
# Ảnh đính kèm nhật ký chăm sóc: chỉ bật khi CRM_ENABLED=true và MinIO + S3_PUBLIC_ENDPOINT đã sẵn sàng.
CRM_ATTACHMENTS_ENABLED=false
# BẮT BUỘC khi CRM_ENABLED=true (thiếu thì backend KHÔNG khởi động). Đúng 32 byte, mã hóa base64:
#   openssl rand -base64 32
# Mỗi môi trường 1 khóa riêng. MẤT hoặc ĐỔI khóa = số CCCD đã mã hóa KHÔNG giải mã lại được (không khôi phục được).
# SAO LƯU khóa NGOÀI máy chủ (secret manager / két mật khẩu) TRƯỚC khi bật CRM; không commit, không gửi qua chat.
CRM_PII_ENCRYPTION_KEY=
# Phiên bản khóa hiện hành (mặc định 1). Xoay khóa: xem RealEstateBackendApp/.env.example.
# CRM_PII_KEY_VERSION=1
# Cờ cố định (compose đặt sẵn, không cần khai báo): FEATURE_CRM_IMPORT=false (M8 chưa làm), FEATURE_CRM_PUSH=false,
# VITE_CRM_MOCK_REPORTS=false và VITE_CRM_MOCK_IMPORT_EXPORT=false (không cho dữ liệu mẫu lọt vào production).

# ════════════ BIẾN HIỆN CÓ (đã có trong .env.docker thật, giữ nguyên) ════════════
# MONGODB_URI và REDIS_URL, S3_ENDPOINT... do docker-compose.yml tự dựng từ các biến trên (đặt qua `environment`,
# ghi đè env_file), nên có thể xóa dòng MONGODB_URI cũ trong .env.docker thật cho khỏi gây nhầm.
# NODE_ENV=production do docker-compose.yml đặt sẵn (không đặt ở đây). Ở production backend yêu cầu:
#   - ADMIN_EMAIL + ADMIN_PASSWORD: tạo tài khoản admin lần đầu (khi DB chưa có user nào). THIẾU thì backend
#     KHÔNG khởi động ("ADMIN_EMAIL/ADMIN_PASSWORD must be set in production"). Có user rồi thì bỏ qua, không ghi đè.
#   - JWT_SECRET, COOKIE_SECRET: chuỗi ngẫu nhiên riêng cho môi trường này (openssl rand -base64 48).
#   - Cookie refresh có cờ Secure: đăng nhập chỉ giữ được qua HTTPS (Cloudflare) hoặc http://localhost.
PORT=3000
JWT_SECRET=<openssl rand -base64 48>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=<openssl rand -base64 48>
# URL công khai của web admin, dùng cho CORS và chuyển hướng sau khi kết nối Google Drive (OAuth).
# Production: https://<domain-admin> (không dấu "/" cuối). Thiếu thì compose dùng http://localhost (OAuth sẽ về localhost).
FRONTEND_URL=https://<domain-admin>
ADMIN_EMAIL=<email-admin>
ADMIN_PASSWORD=<mat-khau-admin-manh>
ADMIN_DISPLAY_NAME=<ten-hien-thi>
FIRECRAWL_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_AI_PROVIDER=
OPENROUTER_AI_MODEL=
MUST1C_API_KEY=
MUST1C_MODEL=
ACTIVE_AI_PLATFORM=
WP_API_URL=
WP_USERNAME=
WP_APP_PASSWORD=
# Token của Cloudflare Tunnel (cloudflared đọc qua docker-compose.yml)
CLOUDFLARE_TUNNEL_TOKEN=
