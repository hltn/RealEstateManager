# ── Admin App (Vite) — mọi biến VITE_* mà mã nguồn đang đọc ────────────────────────────────────────────────
# Sao chép file này thành `.env` rồi chỉnh. Vite nhúng biến vào bundle LÚC BUILD/KHỞI ĐỘNG:
# đổi `.env` thì phải khởi động lại dev server. KHÔNG đặt bí mật (token, mật khẩu) vào biến VITE_*.

# Địa chỉ API backend (mặc định http://localhost:3000/api/v1 nếu bỏ trống). Docker build: truyền --build-arg VITE_API_URL=/api/v1.
VITE_API_URL=http://localhost:3000/api/v1

# ── Module Quản lý khách hàng (CRM) ────────────────────────────────────────────────────────────────────────
# Bật/tắt cả module CRM (route /crm/*, menu "Quản lý khách hàng"). Bỏ trống: bật ở dev, tắt ở bản build production.
# VITE_CRM_ENABLED ưu tiên hơn VITE_CRM_PROTOTYPE (tên cũ, giữ để tương thích).
# VITE_CRM_ENABLED=true
# VITE_CRM_PROTOTYPE=true

# Ảnh đính kèm nhật ký chăm sóc (nút "Thêm ảnh" ở form ghi nhật ký). Mặc định TẮT (nút bị ẩn).
# BẮT BUỘC đi cặp với backend: RealEstateBackendApp/.env phải có FEATURE_CRM_ATTACHMENTS=true,
# nếu backend tắt thì API tải ảnh trả 404 và ảnh không lưu được. DEV KHUYẾN NGHỊ: đặt true ở cả hai phía.
VITE_FEATURE_CRM_ATTACHMENTS=false

# Báo cáo & Thống kê chạy trên DỮ LIỆU MẪU (chưa có API). Bỏ trống: bật ở dev, tắt ở production (màn hiện "sắp ra mắt").
# VITE_CRM_MOCK_REPORTS=false
# Nhập/Xuất file chạy trên DỮ LIỆU MẪU (chưa có API). Bỏ trống: bật ở dev, tắt ở production (ẩn nút).
# VITE_CRM_MOCK_IMPORT_EXPORT=false

# Tính năng giai đoạn sau, mặc định TẮT (chỉ 'true' mới bật):
# Gửi tin Zalo ZNS/OA từ ứng dụng (cần đăng ký OA, có phí).
VITE_CRM_FEATURE_ZALO_ZNS=false
# Gọi khách qua ứng dụng (modal ghi kết quả cuộc gọi).
VITE_CRM_FEATURE_IN_APP_CALL=false
# Tự gửi SMS/ZNS xác nhận lịch hẹn + đồng bộ Google/Outlook Calendar.
VITE_CRM_FEATURE_APPOINTMENT_SYNC=false
