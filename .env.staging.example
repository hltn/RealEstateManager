# Mẫu env cho STAGING LOCAL (scripts/staging.sh init sinh .staging/env từ file này; .staging/ nằm ngoài git).
# File mẫu KHÔNG chứa bí mật: các token __HEXn__ được thay bằng n byte ngẫu nhiên (hex, an toàn cho URL) khi `init`.
# Mọi giá trị đều GIẢ: không dùng token Cloudflare, khóa AI, SMTP... thật ở staging.
COMPOSE_PROJECT_NAME=realestate-staging
MONGO_ROOT_USERNAME=stgroot
MONGO_ROOT_PASSWORD=__HEX24__
MONGO_KEYFILE=__HEX64__
REDIS_PASSWORD=__HEX24__
S3_ACCESS_KEY_ID=stgstorage
S3_SECRET_ACCESS_KEY=__HEX24__
NINE_ROUTER_INITIAL_PASSWORD=__HEX16__
S3_PUBLIC_ENDPOINT=http://localhost
CRM_ENABLED=false
CRM_ATTACHMENTS_ENABLED=false
CRM_PII_ENCRYPTION_KEY=
PORT=3000
JWT_SECRET=__HEX48__
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=__HEX48__
FRONTEND_URL=http://localhost:18080
ADMIN_EMAIL=admin@staging.invalid
ADMIN_PASSWORD=__HEX16__
ADMIN_DISPLAY_NAME=Staging Admin
# compose đòi biến này (cloudflared bị tắt ở staging nên giá trị không được dùng, và KHÔNG phải token thật)
CLOUDFLARE_TUNNEL_TOKEN=staging-fake-token-not-used
