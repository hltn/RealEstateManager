# ── MongoDB (Replica Set — bắt buộc cho transaction) ───────────────────────────
# Dev: dùng container có sẵn `mongodb` (mongodb-atlas-local, RS 1 node, cổng 27017); compose
# dev KHÔNG tạo Mongo. Member host của nó là container-ID nên PHẢI có `directConnection=true`
# (driver nối thẳng 127.0.0.1:27017, bỏ qua host trong replica set config).
# Tên database hiện tại của .env thật là `mongodb` (đổi tên DB phải kèm kế hoạch migrate dữ liệu).
# Production/Staging: dùng URI replica set thật (nhiều host + `replicaSet=<tên>`), không dùng directConnection.
MONGODB_URI=mongodb://127.0.0.1:27017/mongodb?directConnection=true

# ── Server / CORS ───────────────────────────────────────────────────────────────
PORT=3000
# Domain Frontend duy nhất được CORS cho phép (dev: Vite 5173).
FRONTEND_URL=http://localhost:5173

# ── Redis (BullMQ queue, Idempotency, Throttler storage, health readiness) ─────
# Production: dùng rediss:// + mật khẩu (redis://:<password>@host:6379).
REDIS_URL=redis://127.0.0.1:6379

# ── Object storage S3-compatible (MinIO ở dev, S3/R2 ở production) ──────────────
# Dev (MinIO): 2 giá trị minioadmin dưới đây CHỈ dùng cho MinIO local; docker-compose.dev.yml
# cũng đọc chính 2 biến này làm root user/password của MinIO. Production: dùng IAM user
# quyền tối thiểu, KHÔNG commit key thật.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# true cho MinIO (path-style: http://host:9000/<bucket>/<key>); AWS S3 thật để false.
S3_FORCE_PATH_STYLE=true
# Ảnh đính kèm nhật ký chăm sóc (riêng tư, đọc qua signed URL).
S3_BUCKET_ATTACHMENTS=crm-attachments
# File export (bucket có lifecycle tự xóa sau 7 ngày).
S3_BUCKET_EXPORTS=crm-exports
# Hạn signed URL (giây). Mặc định 900 = 15 phút.
S3_SIGNED_URL_TTL_SECONDS=900

# ── Module CRM: mã hóa PII (CCCD) ───────────────────────────────────────────────
# AES-256-GCM: BẮT BUỘC đúng 32 byte, mã hóa base64. Mỗi môi trường 1 khóa riêng.
# Sinh khóa:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# KHÔNG commit giá trị thật; MẤT khóa = không giải mã lại được CCCD đã lưu (backup ở secret manager).
CRM_PII_ENCRYPTION_KEY=
# Phiên bản khóa đang dùng để mã hóa mới (hỗ trợ xoay khóa). Mặc định 1.
CRM_PII_KEY_VERSION=1
# Xoay khóa: các khóa CŨ vẫn cần để giải mã dữ liệu đã mã theo version n, đặt ở CRM_PII_ENCRYPTION_KEY_V<n>
# (n = số version cũ, cùng định dạng 32 byte base64). Quy trình: chép khóa hiện hành sang
# CRM_PII_ENCRYPTION_KEY_V<version hiện hành>, đặt khóa mới vào CRM_PII_ENCRYPTION_KEY, rồi tăng CRM_PII_KEY_VERSION.
# Ví dụ đang ở version 1, muốn lên 2:  CRM_PII_ENCRYPTION_KEY_V1=<khóa cũ>  CRM_PII_ENCRYPTION_KEY=<khóa mới>  CRM_PII_KEY_VERSION=2
# CRM_PII_ENCRYPTION_KEY_V1=

# ── Redis key prefix / Idempotency / S3 public endpoint / Helmet (tùy chọn) ─────
# Tiền tố mọi key Redis của app (dùng chung 1 Redis cho nhiều môi trường thì đặt khác nhau). Mặc định rem:
REDIS_KEY_PREFIX=rem:
# TTL (ms) key idempotency đã hoàn tất. Mặc định 300000 (5 phút).
IDEMPOTENCY_TTL_MS=300000
# TTL (ms) khóa "đang xử lý" của request idempotent. Mặc định 1800000 (30 phút).
IDEMPOTENCY_INFLIGHT_TTL_MS=1800000
# Endpoint S3 mà TRÌNH DUYỆT/app truy cập được, dùng khi ký signed URL (vd khi S3_ENDPOINT là host nội bộ
# docker như http://minio:9000). Để trống = dùng S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
# Bật Content-Security-Policy của Helmet (true | false). Mặc định false vì backend còn phục vụ file tĩnh của
# Admin SPA (CSP chặt dễ vỡ font/script); bật khi SPA được phục vụ riêng (nginx). Swagger UI vẫn chạy khi bật.
HELMET_CSP_ENABLED=false

# ── Hàng đợi BullMQ: worker + job lặp của CRM (M5) ────────────────────────────
# true = tiến trình này chạy worker và đăng ký job lặp (nhắc lịch hẹn, quét dịp đặc biệt/khách lâu chưa chăm sóc,
# dọn ảnh). Nhiều instance cùng true vẫn an toàn (job lặp idempotent, nhắc chỉ gửi một lần). false = chỉ phục vụ
# HTTP (tách tiến trình worker khi scale). Thiếu: true, trừ khi NODE_ENV=test (test không mở kết nối nền).
# Cần Redis (REDIS_URL) và FEATURE_CRM_ENABLED=true thì mới chạy việc nhắc.
QUEUE_WORKERS_ENABLED=true

# ── Feature flags module CRM (true | false; thiếu = false) ──────────────────────
# Mặc định tắt để merge code an toàn. Dev local: bật FEATURE_CRM_ENABLED=true (+ ATTACHMENTS).
FEATURE_CRM_ENABLED=false
FEATURE_CRM_ATTACHMENTS=false
FEATURE_CRM_IMPORT=false
# Push FCM thuộc giai đoạn 2: giữ false, FCM_* để trống.
FEATURE_CRM_PUSH=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ── Auth / Cookie / tài khoản admin khởi tạo ────────────────────────────────────
# Mỗi môi trường 1 giá trị ngẫu nhiên riêng (vd: openssl rand -base64 48). KHÔNG commit giá trị thật.
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=
# Tài khoản admin seed lần đầu. Production: BẮT BUỘC đặt ADMIN_EMAIL + ADMIN_PASSWORD (thiếu sẽ fail-fast).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=

# ── OpenRouter AI ───────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_AI_PROVIDER=
OPENROUTER_AI_MODEL=

# ── Google OAuth (Google Drive export) ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Tùy chọn: secret ký state OAuth (thiếu thì fallback GOOGLE_CLIENT_SECRET).
GOOGLE_OAUTH_STATE_SECRET=

# ── Daily News Crawler ──────────────────────────────────────────────────────────
# Backend ghi lại 2 biến này vào file .env (CRON_CONFIG_FILE) khi bật/tắt crawler.
DAILY_CRAWLER_ACTIVE=false
# Biểu thức cron (mặc định 0 8 * * * = 8h sáng hằng ngày).
DAILY_CRAWLER_FREQUENCY=0 8 * * *

# ── Khác ────────────────────────────────────────────────────────────────────────
WP_API_URL=https://your-wordpress-site.com/wp-json/wp/v2
WP_USERNAME=your_username
WP_APP_PASSWORD=your_app_password

# Firecrawl API key (get from https://firecrawl.dev)
FIRECRAWL_API_KEY=

# Gemini API key (get from https://aistudio.google.com)
GEMINI_API_KEY=

# Target URL to scrape news
CRAWL_TARGET_URL=https://vnexpress.net/bat-dong-san

# ── Logging (daily-rotation file logger) ──────────────────────────────────────
# Môi trường runtime: development | staging | production
NODE_ENV=development
# Log level ngưỡng (error | warn | info | debug | verbose). File chỉ ghi >= info.
LOG_LEVEL=info
# Thư mục lưu file log (tạo runtime, KHÔNG commit). Đường dẫn tương đối cwd.
LOG_DIR=logs
# Số ngày giữ file log (retention), file cũ tự xoá + nén gzip.
LOG_RETENTION_DAYS=14

# ── Timezone (lọc bài viết theo ngày) ──────────────────────────────────────
# Offset giờ Việt Nam (Asia/Ho_Chi_Minh) so với UTC. VN không có DST nên số
# giờ cố định là đủ, không cần thư viện timezone. Dùng để quy đổi startDate/
# endDate (YYYY-MM-DD, theo giờ VN) sang mốc UTC thật khi lọc bài viết
# (news-fire-crawl-manager) — xem src/common/utils/timezone.util.ts.
APP_TIMEZONE_OFFSET_HOURS=7


ACTIVE_AI_PLATFORM=Must1c

# Must1c AI Config
MUST1C_API_KEY=
MUST1C_MODEL=

# 9Router AI Config
NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1
NINEROUTER_API_KEY=
NINEROUTER_MODEL=

# ── Auth throttle (CHỈ dùng cho dev/E2E; production luôn bỏ qua biến này) ───
# Nới giới hạn POST /auth/login (mặc định 5 lần/phút/IP khi bỏ trống).
# Số nguyên dương thuần trong khoảng 1-10000; giá trị sai sẽ làm app báo lỗi khi khởi tạo.
# AUTH_LOGIN_THROTTLE_LIMIT=
