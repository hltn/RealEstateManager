{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": {
      "type": "swc",
      "options": {
        "ignore": ["**/*.spec.ts", "**/*.fixture.ts"]
      }
    },
    "deleteOutDir": true,
    "assets": [
      {
        "include": "modules/news-fire-crawl-manager/constants/*.json",
        "outDir": "dist"
      }
    ]
  }
}
